{
  "name": "dentacare",
  "productName": "DentaCare",
  "version": "4.0.0",
  "description": "Gestion de cabinet dentaire hors ligne : React + Electron + Node.js + SQLite",
  "private": true,
  "main": "dist/electron/main.cjs",
  "license": "UNLICENSED",
  "scripts": {
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:web && npm run build:server",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "serve": "node dist/server/index.cjs",
    "selftest": "node dist/server/index.cjs --selftest",
    "reset-password": "node dist/server/index.cjs --reset-password",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "express": "5.3.0",
    "sql.js": "1.15.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "build": {
    "appId": "fr.dentacare.desktop",
    "productName": "DentaCare",
    "directories": { "output": "release" },
    "files": ["dist/**", "package.json", "node_modules/**"],
    "asarUnpack": ["node_modules/sql.js/dist/*.wasm"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true }
  }
}
